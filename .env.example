# ==============================================================================
# NovaSentry Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000

# SQLite Database File Path
DATABASE_PATH=novasentry.db

# Application Environment (development / production)
APP_ENV=development

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info

# Default Superadmin Credentials (seeded automatically if not present)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=sentry123

# ==============================================================================
# Upstream AI Gateways & Upstream Model Keys
# ==============================================================================

# Google Gemini Free API Key (Get free key at: https://aistudio.google.com/)
# Used when client routes to models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Optional 9Router / Custom Upstream Gateway Endpoint
ROUTER_UPSTREAM_ENDPOINT=http://127.0.0.1:20000/v1

